#!/bin/bash
# End-of-turn hook: in a folder linked to a space, sends EVY what the session said since the last send (the person's
# messages and the agent's answers, never tool output or file contents; evy-transcript.js picks them out), so EVY can
# write what moved into the space's Updates note without the agent having to report it, and tells EVY the turn ended,
# so To-do can say the session waits on the person. Runs in the background and never holds up the turn, never asks
# the agent anything, and never runs in runs (they report through their task).
# The turn's text needs macOS's osascript; elsewhere only the turn's end is sent. EVY_SHIP_WAIT=1 sends in the
# foreground (the tests).
. "$(dirname "$0")/evy-lib.sh"

[ "${COMPASS_RUNNER:-}" = "1" ] && exit 0
EVY_INPUT="$(cat)"
session="$(evy_field session_id)"
dir="$(evy_session_dir "$session")" || exit 0
folder="${CLAUDE_PROJECT_DIR:-$(evy_field cwd)}"
folder="${folder:-$PWD}"
# The agent stopped and waits for the person (TK2), on any machine, also in a folder of no space once the session
# claimed a task there (TK5)
{ [ -f "$dir/linked" ] || [ -f "$dir/claimed" ]; } && evy_presence "$session" ended "$folder"
[ -f "$dir/linked" ] || exit 0
transcript="$(evy_field transcript_path)"
[ -r "$transcript" ] || exit 0
command -v osascript >/dev/null 2>&1 || exit 0
base="$(evy_base)" || exit 0
token="$(evy_token "$EVY_KIND")" || exit 0
[ -n "$token" ] || exit 0
reader="$(dirname "$0")/evy-transcript.js"

ship() {
  # One send at a time per session; a turn that ends while one runs is sent with the next.
  mkdir "$dir/sending" 2>/dev/null || return 0
  trap 'rm -rf "$dir/sending"' EXIT
  local size from body status
  size="$(wc -c < "$transcript" | tr -d ' ')"
  from="$(cat "$dir/shipped" 2>/dev/null)"
  from="${from:-0}"
  [ "$size" -gt "$from" ] 2>/dev/null || return 0
  tail -c +"$((from + 1))" "$transcript" | head -c "$((size - from))" |
    osascript -l JavaScript "$reader" "$folder" "$(evy_repo_folder "$folder")" "$session" chat > "$dir/sending/body" 2>/dev/null
  if [ ! -s "$dir/sending/body" ]; then
    printf '%s' "$size" > "$dir/shipped"
    return 0
  fi
  # The token goes to curl on stdin, never on its command line where other processes could read it.
  status="$(printf 'header = "Authorization: Bearer %s"\n' "$token" | curl -sS -K - --max-time 20 -o /dev/null -w '%{http_code}' \
    -H 'Content-Type: application/json' --data-binary @"$dir/sending/body" "$base/runner/api/turns" 2>/dev/null)"
  # Kept for the next turn when EVY was out of reach, so nothing said is lost.
  case "$status" in 2*) printf '%s' "$size" > "$dir/shipped" ;; esac
}

if [ "${EVY_SHIP_WAIT:-}" = "1" ]; then
  ship
else
  (ship) </dev/null >/dev/null 2>&1 &
fi
exit 0
