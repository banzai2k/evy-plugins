#!/bin/bash
# End-of-turn hook: when this session changed something EVY has not heard about (a commit, or in a folder without
# git a file it wrote) since its last report, decision or progress update, asks the agent once to update EVY. Only in
# folders linked to a space, never in runs (they report through the task), and never twice for the same change.
. "$(dirname "$0")/evy-lib.sh"

[ "${COMPASS_RUNNER:-}" = "1" ] && exit 0
EVY_INPUT="$(cat)"
case "$(printf '%s' "$EVY_INPUT" | tr -d '[:space:]')" in *'"stop_hook_active":true'*) exit 0 ;; esac
dir="$(evy_session_dir "$(evy_field session_id)")" || exit 0
[ -f "$dir/linked" ] || exit 0
transcript="$(evy_field transcript_path)"
[ -r "$transcript" ] || exit 0

folder="${CLAUDE_PROJECT_DIR:-$(evy_field cwd)}"
if evy_in_git "${folder:-$PWD}"; then
  changed='"name":"Bash".*git commit|"type":"function_call".*git commit'
else
  changed='"name":"(Edit|Write|MultiEdit|NotebookEdit)"|apply_patch'
fi
last_line() { grep -n -E "$1" "$transcript" | grep -E '"type":"(tool_use|function_call)"' | tail -n 1 | cut -d: -f1; }
change="$(last_line "$changed")"
told="$(last_line '"(mcp__plugin_evy_evy|mcp__evy)__(update_progress|record_decision|report)"')"
asked="$(cat "$dir/asked" 2>/dev/null)"
[ -n "$change" ] || exit 0
[ "${told:-0}" -lt "$change" ] || exit 0
[ "${asked:-0}" -lt "$change" ] || exit 0
printf '%s' "$change" > "$dir/asked"

printf '{"decision":"block","reason":%s}\n' "$(evy_json "EVY has not heard about what this session changed. If it changes where the space stands, call update_progress with the whole summary (at most 150 words, one plain fact per line), or record_decision for something the person decided. If it changes nothing there, stop without another word.")"
exit 0
