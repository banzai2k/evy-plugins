#!/bin/bash
# The headers Claude Code (or Codex) sends to EVY's tools: this Mac's agent token, read from EVY Desktop's env file at
# each connection, so it never sits in a config file, the folder the session works in, and the session's id where the
# agent gives it (so EVY ties tool calls to the tasks the session claimed), and for Claude Code the plugin's version.
# Usage: evy-headers [folder]
. "$(dirname "$0")/evy-lib.sh"

folder="${1:-$PWD}"
token="$(evy_token "$EVY_KIND")" || token=""
[ -n "$token" ] || { echo '{}'; exit 0; }
# The token goes only to the EVY this Mac is paired with, whatever address the plugin was given. Claude Code masks
# any part of the address that equals a secret in its environment as REDACTED, so a masked part matches anything.
if [ -n "${CLAUDE_CODE_MCP_SERVER_URL:-}" ]; then
  base="$(evy_base)" || base=""
  pattern="$(printf '%s' "$CLAUDE_CODE_MCP_SERVER_URL" | sed -e 's/[][?*\\]/\\&/g' -e 's/REDACTED/*/g')"
  # shellcheck disable=SC2254
  case "$base/mcp" in $pattern) ;; *) echo '{}'; exit 0 ;; esac
fi

kind=chat
[ "${COMPASS_RUNNER:-}" = "1" ] && kind=run
out="{\"Authorization\":$(evy_json "Bearer $token"),\"X-EVY-Kind\":\"$kind\",\"X-EVY-Folder\":$(evy_json "$folder")"
repo="$(evy_repo_folder "$folder")"
[ -n "$repo" ] && out="$out,\"X-EVY-Repo-Folder\":$(evy_json "$repo")"
session="$(evy_session_id)"
[ -n "$session" ] && out="$out,\"X-EVY-Session\":$(evy_json "$session")"
# Claude Code runs the plugin's upload hook after each report; its version tells EVY which files that hook sends
# (PHS1: design pages from a build box), so EVY never asks the agent again for pages on their way. Codex has no such hook.
if [ "$EVY_KIND" = "claude-code" ]; then
  version="$(evy_plugin_version)"
  [ -n "$version" ] && out="$out,\"X-EVY-Plugin\":$(evy_json "$version")"
fi
printf '%s}\n' "$out"
