#!/bin/bash
# Prompt hook: before each message the person sends in a folder linked to a space (or once the session claimed a
# task), adds what is new in EVY since the session last heard (the person's replies on its tasks, its tasks that
# changed state, Updates lines from other sessions, the chat and agents' decisions, notes people changed), each item
# once, and tells EVY the session's turn started. Turns the person did not type hear it from evy-turn-news. Prints
# nothing when nothing is new, when EVY is out of reach (after 4 seconds at most), and in runs.
. "$(dirname "$0")/evy-lib.sh"

[ "${COMPASS_RUNNER:-}" = "1" ] && exit 0
EVY_INPUT="$(cat)"
session="$(evy_field session_id)"
dir="$(evy_session_dir "$session")" || exit 0
folder="${CLAUDE_PROJECT_DIR:-$(evy_field cwd)}"
folder="${folder:-$PWD}"
# The person sent a message: the session's turn started (TK2), also in a folder of no space once the session
# claimed a task there (TK5)
{ [ -f "$dir/linked" ] || [ -f "$dir/claimed" ]; } && evy_presence "$session" started "$folder"
{ [ -f "$dir/linked" ] || [ -f "$dir/claimed" ]; } || exit 0
# This turn heard the news: the hook after its first tool call need not ask again (PLG2).
: > "$dir/turn-open"
evy_news "$session" "$folder"
exit 0
